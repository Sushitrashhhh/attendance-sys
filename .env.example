# Neon PostgreSQL Database Connection (Must be pooled or direct)
# Example: postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional Direct Connection for Migrations (Non-pooled host without -pooler suffix)
# DATABASE_URL_UNPOOLED=

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173

# Biometric & Liveness Parameters
RECOGNITION_THRESHOLD=0.65
LIVENESS_THRESHOLD=0.70

# Application Environment (development, testing, production)
APP_ENV=development
